PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Start with sandbox credentials from https://developer.paypal.com/dashboard/
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
PAYPAL_WEBHOOK_ID=replace_with_webhook_id_after_registering_webhook

# Use at least 32 random bytes; generate with: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=replace_with_64_hex_char_random_secret
